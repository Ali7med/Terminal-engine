<UserControl x:Class="TerminalLauncher.Controls.TerminalTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TerminalLauncher.Services"
             xmlns:ctrl="clr-namespace:TerminalLauncher.Controls"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <!-- زرّ تمرير شفّاف (بلا كروم افتراضيّ) — لمنطقة الصفحة فقط -->
        <Style x:Key="TransparentRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- شريط تمرير نحيل متوافق مع الثيم (مقبض دائريّ، بلا أسهم، مسار شفّاف) -->
        <Style x:Key="SlimScroll" TargetType="ScrollBar">
            <Setter Property="Width" Value="9"/>
            <Setter Property="MinWidth" Value="9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TransparentRepeat}" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TransparentRepeat}" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Th" CornerRadius="4" Margin="2,0"
                                                        Background="{DynamicResource Brush.Border}"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Th" Property="Background"
                                                                Value="{DynamicResource Brush.Accent}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- صفّ لوحة منسدلة (الاقتراحات ومتصفّح المجلدات): ممتدّ من الحافّة للحافّة، تمرير الفأرة
             يُظلّله والمحدَّد باللكنة كاملةً بنصّ أبيض. قالب مخصّص لأنّ تحديد WPF الافتراضيّ أزرق نظاميّ
             لا يتبع الثيم. النصوص الداخليّة لا تضبط Foreground صراحةً كي ترثه من الصفّ. -->
        <Style x:Key="PanelRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource Brush.KeyCap}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource Brush.Accent}"/>
                                <Setter TargetName="Row" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- مقطع في مبدّل الوضع (أمر/ذكاء): حبّة صغيرة تُملأ باللكنة حين تكون هي الوضع النشط. -->
        <Style x:Key="ComposerSeg" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Brush.RowHover}"/>
                            </Trigger>
                            <!-- بعد المرور عمداً: الوضع النشط يجب أن يظلّ ظاهراً تحت المؤشّر -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- زرّ نصّيّ بلا كروم (مثل «لا تُظهر ثانيةً») -->
        <Style x:Key="ComposerLink" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <!-- سطح واحد موحّد بخلفية التيرمنال (تُصبح شفّافة عند تفعيل صورة خلفيّة لتظهر خلف التيرمنال) -->
    <Grid x:Name="RootGrid" Background="{DynamicResource Brush.TerminalBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- العمود الثاني يستضيف لوحة الـAI (مطويّة افتراضاً). أبناء الشبكة القدامى بلا
             Grid.Column فيبقون في العمود 0 — إضافة العمود لا تحرّك شيئاً حتى تُفتح اللوحة. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- شريط علوي: خلفيّته تُطابق تعتيم التيرمنال (تُضبَط في SetBackgroundAlpha) فيصير الشريط
             والتيرمنال والإنبت سطحاً واحداً متّصلاً؛ يفصلهم خطّ شعرة رفيع فقط لا حدّ بارز ولا بنل. -->
        <Border x:Name="HeaderBar" Grid.Row="0" Padding="8,5"
                Background="{DynamicResource Brush.TerminalBg}"
                BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="ShellCombo" Width="160"
                              DisplayMemberPath="Display"
                              SelectionChanged="ShellCombo_SelectionChanged"
                              DropDownOpened="ShellCombo_DropDownOpened"
                              DropDownClosed="ShellCombo_DropDownClosed"
                              ToolTip="الصدفة الافتراضية لهذا الأمر (يُحفظ التغيير)"/>
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource Brush.TextMuted}"
                               VerticalAlignment="Center" Margin="12,0" FontSize="{DynamicResource Size.Small}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- شريط أيقونات موحَّد: ثمانية أزرار بحجمٍ واحد (13) — إمّا محرفٌ نصّيّ عاديّ
                         («✦» و«⏱») يتبع لون النصّ وحجمه كبقيّة الواجهة، أو Segoe MDL2 Assets. كانت
                         مزيجاً من رموز تعبيريّة ملوّنة («✨» «🕘» «🧹») ونصّيّة افتراضيّة («↻» «■» «✕»)
                         وأيقونتَي MDL2 بحجمٍ أصغر (12) — فبدت غير متناسقة حجماً ونمطاً. -->

                    <!-- نقطة الدخول الموحّدة لمساعد الـAI: ميزة خلف قائمة سياق لا يجدها أحد. -->
                    <ToggleButton x:Name="AiToggleButton" Style="{StaticResource IconToggle}"
                                  Content="✦" FontSize="13" Click="AiToggleButton_Click"/>
                    <!-- سجلّ الأوامر (T-106): زرّ يفتح Popup بقائمة الأوامر الأخيرة.
                         ‏E81C = History. كان محرف الساعة «⏱» — وهو عين الرمز الذي كان يسبق المدّة
                         المنقضية في شريط الحالة على بُعد سنتيمترات، فيقرأ العينُ ساعتين متطابقتين
                         في شريطٍ واحد. المدّة صارت بلا رمز، والزرّ صار أيقونة MDL2 كبقيّة الشريط. -->
                    <Button x:Name="HistoryButton" Style="{StaticResource IconButton}"
                            Content="&#xE81C;" FontFamily="Segoe MDL2 Assets"
                            FontSize="13" Click="HistoryButton_Click"
                            ToolTip="{loc:T term.history}"/>
                    <Popup x:Name="HistoryPopup" PlacementTarget="{Binding ElementName=HistoryButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                           FlowDirection="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Border Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                CornerRadius="9" Padding="4" Margin="6" MinWidth="320" MaxWidth="520">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" Color="#000000"/>
                            </Border.Effect>
                            <DockPanel>
                                <!-- بحث سريع: يصفّي أثناء الكتابة؛ الأسهم تتنقّل والقائمة، Enter يلصق وينفّذ -->
                                <Border DockPanel.Dock="Top" Margin="2,2,2,4" Padding="8,5" CornerRadius="6"
                                        Background="{DynamicResource Brush.Bg}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                    <TextBox x:Name="HistorySearch" BorderThickness="0" Background="Transparent"
                                             Foreground="{DynamicResource Brush.Text}" VerticalContentAlignment="Center"
                                             FontFamily="Cascadia Mono, Consolas"
                                             TextChanged="HistorySearch_TextChanged"
                                             PreviewKeyDown="HistorySearch_PreviewKeyDown"/>
                                </Border>
                                <ListBox x:Name="HistoryList" MaxHeight="320" BorderThickness="0"
                                         Background="Transparent" Foreground="{DynamicResource Brush.Text}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         MouseDoubleClick="HistoryList_MouseDoubleClick"
                                         PreviewKeyDown="HistoryList_PreviewKeyDown">
                                    <ListBox.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScroll}"/>
                                    </ListBox.Resources>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="8,5"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                                       FontFamily="Cascadia Mono, Consolas"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Popup>
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Click="RestartButton_Click"
                            ToolTip="{loc:T term.restart}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="13" Click="StopButton_Click"
                            ToolTip="{loc:T term.stop}"/>
                    <!-- ‏E894 = Clear (تنظيف الشاشة). كان E74D = Delete (سلّة مهملات) — يقرأ
                         «احذف» لا «نظّف الشاشة»، وهو الرمز نفسه المستعمَل للحذف في بقيّة التطبيق. -->
                    <Button Style="{StaticResource IconButton}" Content="&#xE894;" FontFamily="Segoe MDL2 Assets" FontSize="13" Click="ClearButton_Click"
                            ToolTip="{loc:T term.clear}"/>
                    <!-- فصل: نقرة → نافذة مستقلّة · Shift+نقرة → تيرمنال خارجيّ بنفس المسار (E8A7 = OpenInNewWindow) -->
                    <Button x:Name="DetachButton" Style="{StaticResource IconButton}"
                            Content="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                            Click="DetachButton_Click"
                            ToolTip="{loc:T term.detach}"/>
                    <!-- الأيقونة تتبع الحالة: E740 (توسيع) ⇄ E73F (إرجاع). كانت ثابتة على E740،
                         فتشابهت مع E8A7 المجاورة (كلتاهما إطارٌ وسهم) ولم تقل أيّ وضعٍ نحن فيه. -->
                    <ToggleButton x:Name="ExpandToggle" Style="{StaticResource IconToggle}"
                                  Content="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                  Click="ExpandToggle_Click" ToolTip="{loc:T term.expand}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="13" Click="CloseButton_Click"
                            ToolTip="{loc:T term.closePane}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- تقسيم أفقيّ: عمود التيرمنال + فاصل قابل للسحب + عمود محرّر الملفّ (مطويّ افتراضياً — T-7).
             العمودان يتشاركان الصفّ؛ يبدأ عمود المحرّر بعرض 0 وإخفاء، ويُظهَر بنصف العرض عند فتح ملفّ. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TerminalColumn" Width="*"/>
                <ColumnDefinition x:Name="SplitterColumn" Width="Auto"/>
                <ColumnDefinition x:Name="EditorColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- محاكي الكونسول: عارض شبكة خلايا SkiaSharp (SGR/ألوان/كتل/روابط تُرسَم داخلياً).
                 للقراءة فقط بمنطق كونسول: PreviewTextInput/التحديد/النسخ/التمرير كلّها على العارض.
                 العارض يستقبل تركيز لوحة المفاتيح (Focusable) ويرسم LTR مهما كان اتّجاه الواجهة. -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <!-- صندوق التأليف: ارتفاع تلقائيّ، مطويّ حتى يُفعَّل ويكون على الشاشة الأساس -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <!-- العارض يملأ العرض كاملاً (كعرض الرأس). شريط التمرير يطفو داخليّاً على الحافّة
                         اليمنى (LTR) بلا اقتطاع عرض — يظهر فقط عند الحاجة، فوق آخر عمود (هامش عادةً). -->
                    <ctrl:SkiaTerminalRenderer x:Name="Renderer"
                                               Margin="0"
                                               Focusable="True" ClipToBounds="True"
                                               FlowDirection="LeftToRight"
                                               PreviewKeyDown="Renderer_PreviewKeyDown"
                                               PreviewTextInput="Renderer_PreviewTextInput"
                                               PreviewMouseLeftButtonDown="Renderer_MouseLeftDown"
                                               PreviewMouseMove="Renderer_MouseMove"
                                               PreviewMouseLeftButtonUp="Renderer_MouseLeftUp"
                                               PreviewMouseRightButtonUp="Renderer_MouseRightUp"
                                               PreviewMouseWheel="Renderer_MouseWheel"/>
                    <ScrollBar x:Name="Scroll" Orientation="Vertical" Style="{StaticResource SlimScroll}"
                               HorizontalAlignment="Left" Margin="0,2"
                               Scroll="Scroll_Scroll"/>

                    <!-- شريط البحث في المخرجات (Ctrl+F) — يظهر أعلى الزاوية فوق التيرمنال، LTR داخلياً -->
                    <Border x:Name="SearchBar" Visibility="Collapsed"
                            VerticalAlignment="Top" HorizontalAlignment="Right" Margin="10"
                            FlowDirection="LeftToRight"
                            Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="9" Padding="6,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="SearchInput" Width="180" Height="26"
                                     BorderThickness="0" Background="Transparent" Padding="6,2"
                                     VerticalContentAlignment="Center"
                                     TextChanged="SearchInput_TextChanged"
                                     PreviewKeyDown="SearchInput_PreviewKeyDown"/>
                            <TextBlock x:Name="SearchCount" MinWidth="54" Margin="6,0" FontSize="{DynamicResource Size.Small}"
                                       VerticalAlignment="Center" TextAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                            <Button Style="{StaticResource IconButton}" Content="‹" FontSize="{DynamicResource Size.Heading}"
                                    Click="SearchPrev_Click" ToolTip="{loc:T find.prev}"/>
                            <Button Style="{StaticResource IconButton}" Content="›" FontSize="{DynamicResource Size.Heading}"
                                    Click="SearchNext_Click" ToolTip="{loc:T find.next}"/>
                            <Button Style="{StaticResource IconButton}" Content="✕"
                                    Click="SearchClose_Click" ToolTip="{loc:T find.close}"/>
                        </StackPanel>
                    </Border>

                    <!-- لوحة النوم: تغطّي الشبكة ما دام التبويب نائماً. الإيقاظ فعلٌ صريح (زرّ) لا
                         مجرّد دخولٍ إلى التبويب — وإلّا لم يبقَ للنوم معنى، إذ يكفي المرور عليه لِيُشغَّل. -->
                    <Border x:Name="SleepOverlay" Visibility="Collapsed"
                            Background="{DynamicResource Brush.TerminalBg}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                            <!-- E708 = QuietHours (هلال) -->
                            <TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                                       HorizontalAlignment="Center" Opacity="0.55"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                            <TextBlock x:Name="SleepTitle" Margin="0,14,0,0" HorizontalAlignment="Center"
                                       FontSize="{DynamicResource Size.Heading}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text}"/>
                            <TextBlock x:Name="SleepHint" Margin="0,7,0,0" HorizontalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" Opacity="0.75"
                                       FontSize="{DynamicResource Size.Ui}"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                            <Button x:Name="SleepWakeButton" Margin="0,18,0,0" Padding="18,7"
                                    HorizontalAlignment="Center" Click="SleepWake_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- طبقة اللوحات المنسدلة (اقتراحات + متصفّح مجلدات). الحاوية نفسها LTR: الواجهة
                         عربيّة (RTL) فـ HorizontalAlignment="Left" داخلها كان ينقلب إلى يمين الشاشة —
                         اللوحتان يجب أن ترسوا يسار الإنبت بمحاذاة شيب الباث. بلا خلفيّة ⇒ لا تلتقط
                         نقرات التيرمنال في الفراغ. -->
                    <Grid FlowDirection="LeftToRight">

                    <!-- قائمة الاقتراحات: طبقة *داخل* التطبيق (لا Popup) — Popup نافذة نظام مستقلّة تبقى
                         طافية فوق كلّ البرامج حتّى بعد تبديل التطبيق؛ هنا هي عنصر عاديّ يعلو التيرمنال
                         (آخر الشجرة ⇒ أعلى Z) ويختفي بطبيعته مع النافذة. تُرسى للأسفل فوق الإنبت مباشرةً
                         فلا تزحف التيرمنال. -->
                    <Border x:Name="SuggestPanel" Visibility="Collapsed"
                            VerticalAlignment="Bottom" HorizontalAlignment="Left"
                            MinWidth="360" MaxWidth="680" Margin="16,0,16,4"
                            CornerRadius="10" Padding="0,4"
                            Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.5" Color="#000000"/>
                        </Border.Effect>
                        <ListBox x:Name="SuggestList" MaxHeight="260" BorderThickness="0" Padding="0"
                                 Background="Transparent" Focusable="False"
                                 Foreground="{DynamicResource Brush.Text}"
                                 ItemContainerStyle="{StaticResource PanelRow}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseLeftButtonUp="SuggestList_Click">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScroll}"/>
                            </ListBox.Resources>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="{DynamicResource Size.Small}"
                                                   VerticalAlignment="Center" Opacity="0.9"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Text}"
                                                   FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource Size.Small}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <!-- وصف دور الأمر/السكربت — يوضّح *لماذا* اقتُرح -->
                                        <TextBlock Grid.Column="2" Text="{Binding Desc}" Margin="12,0,0,0"
                                                   FontSize="{DynamicResource Size.Small}" Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Kind}" Margin="12,0,0,0"
                                                   FontSize="{DynamicResource Size.Tiny}" Opacity="0.5" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- متصفّح المجلدات: يفتحه زرّ الباث فوق الإنبت. طبقة داخل التطبيق (لا Popup) —
                         بحث فوريّ + «..» للصعود + نقرة على مجلد = cd إليه. -->
                    <Border x:Name="CwdPickerPanel" Visibility="Collapsed"
                            VerticalAlignment="Bottom" HorizontalAlignment="Left"
                            MinWidth="290" MaxWidth="460" Margin="16,0,0,4"
                            CornerRadius="10" Padding="0,0,0,4"
                            Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="1"
                            IsKeyboardFocusWithinChanged="CwdPicker_FocusChanged">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.5" Color="#000000"/>
                        </Border.Effect>
                        <DockPanel>
                            <!-- سطر البحث: بلا صندوق — خطّ شعرة فاصل فقط، كتصميم لوحات الأوامر -->
                            <Border DockPanel.Dock="Top" Padding="12,9,12,8"
                                    BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <!-- نصّ إرشاديّ يظهر ما دام الحقل فارغاً -->
                                    <TextBlock x:Name="CwdPickerHint" IsHitTestVisible="False" FontSize="{DynamicResource Size.Small}"
                                               VerticalAlignment="Center" Opacity="0.45"
                                               Foreground="{DynamicResource Brush.TextMuted}"/>
                                    <TextBox x:Name="CwdPickerSearch" BorderThickness="0" Padding="0"
                                             Background="Transparent" FontSize="{DynamicResource Size.Small}"
                                             Foreground="{DynamicResource Brush.Text}"
                                             CaretBrush="{DynamicResource Brush.Accent}"
                                             VerticalContentAlignment="Center"
                                             TextChanged="CwdPickerSearch_TextChanged"
                                             PreviewKeyDown="CwdPickerSearch_PreviewKeyDown"/>
                                </Grid>
                            </Border>
                            <ListBox x:Name="CwdPickerList" MaxHeight="300" BorderThickness="0"
                                     Background="Transparent" Focusable="False" Padding="0,4,0,0"
                                     Foreground="{DynamicResource Brush.Text}"
                                     ItemContainerStyle="{StaticResource PanelRow}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     PreviewMouseLeftButtonUp="CwdPickerList_Click">
                                <ListBox.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScroll}"/>
                                </ListBox.Resources>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- أيقونة خطّية (Segoe MDL2) لا إيموجي — تتلوّن مع نصّ الصفّ -->
                                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" Width="22" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Display}" FontSize="{DynamicResource Size.Small}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    </Grid>
                </Grid>

                <!-- ===== صندوق التأليف الغنيّ (نمط Warp) =====
                     صندوق إدخال منفصل واضح: يُكتب فيه الأمر، تظهر قائمة اقتراحات فوقه (تاريخ + أوامر
                     شائعة + ملفات المجلد)، والإكمال الشبحيّ inline يُقبَل بـ Tab. يُرسَل عند Enter.
                     يظهر على الشاشة الأساس فقط ويختفي في الشاشة البديلة (vim/less). LTR داخليّاً. -->
                <!-- الإنبت والتيرمنال قطعة واحدة: خلفيّة شفّافة (تظهر خلفهما الصورة نفسها) ويفصلهما
                     خطّ شعرة رفيع فقط لا بنل صلبة — كتصميم Warp. -->
                <Border x:Name="ComposerBar" Grid.Row="1" Visibility="Collapsed"
                        FlowDirection="LeftToRight" Margin="0"
                        Background="Transparent"
                        BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <!-- بطاقة ترحيب «جلسة تيرمنال جديدة»: اختصارات الصندوق أوّل ما يُفتح تبويب،
                             وتُصرَف نهائيّاً بزرّ «لا تُظهر ثانيةً». -->
                        <Border x:Name="WelcomeCard" DockPanel.Dock="Top" Visibility="Collapsed"
                                Padding="16,12,16,13" Background="Transparent"
                                BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                        <!-- E946 = Info -->
                                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource Brush.Accent}"/>
                                        <TextBlock x:Name="WelcomeTitle" FontSize="{DynamicResource Size.Menu}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel x:Name="WelcomeRows"/>
                                </StackPanel>
                                <Button x:Name="WelcomeDismissBtn" Grid.Column="1"
                                        VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                        Style="{StaticResource ComposerLink}" Click="WelcomeDismiss_Click">
                                    <TextBlock x:Name="WelcomeDismissText" FontSize="{DynamicResource Size.Ui}"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- شريط نتيجة الذكاء: الجواب يأتي حيث سُئل — فوق الصندوق مباشرةً، بلا
                             فتح لوحة الدردشة ونقلِ التركيز إليها. -->
                        <ctrl:AiInlineResult x:Name="AiInline" DockPanel.Dock="Top"/>

                        <!-- منطقة الإدخال: صفّ الباث والمبدّل فوق، ثمّ صفّ الموجّه + الحقل -->
                        <StackPanel x:Name="ComposerInputArea" Margin="16,12,16,16">
                            <!-- صفّ علويّ: «شيب» الباث يساراً (يفتح متصفّح المجلدات، وحافّته تحاذي
                                 حافّة اللوحة فتفتح فوقه تماماً) ومبدّل الوضع يميناً. -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                            <!-- المسار ورقاقة النموذج في صفّ أفقيّ واحد. سبق أن كانا في خليّة
                                 الشبكة نفسها فتراكب نصّاهما: الشبكة تكدّس أبناء الخليّة الواحدة
                                 فوق بعضهم، ولا ترصفهم. -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CwdPickerButton" HorizontalAlignment="Left" Margin="0"
                                    Padding="12,7" Cursor="Hand" Click="CwdPicker_Click" Focusable="False">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" CornerRadius="7" Padding="{TemplateBinding Padding}"
                                                            Background="Transparent"
                                                            BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="1">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background"
                                                                    Value="{DynamicResource Brush.KeyCap}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <!-- E8B7 = Folder · E70D = ChevronDown -->
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Margin="0,0,7,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextMuted}"/>
                                    <TextBlock x:Name="ComposerCwd" VerticalAlignment="Center" MaxWidth="520"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource Size.Small}"
                                               Foreground="{DynamicResource Brush.TextMuted}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="CwdPickerChevron" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                               Margin="7,1,0,0" VerticalAlignment="Center" Opacity="0.7"
                                               Foreground="{DynamicResource Brush.TextMuted}"/>
                                </StackPanel>
                            </Button>

                                <!-- رقاقة النموذج تلي المسار في الصفّ نفسه: تقول أيّ نموذج سيجيب،
                                     وتفتح لوحة اختيار. رقاقة لا منسدلة — قائمة بمئات النماذج داخل
                                     ComboBox في شريط ضيّق تمطّه وتقتطع الأسماء، واللوحة تعطيها
                                     مساحتها كاملةً. -->
                                <Button x:Name="ComposerModelChip" Visibility="Collapsed"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0" Padding="10,6" Cursor="Hand"
                                        Focusable="False" Click="ComposerModelChip_Click"
                                        Style="{Binding ElementName=CwdPickerButton, Path=Style}">
                                <StackPanel Orientation="Horizontal">
                                    <!-- ‏«✦» لا «✨»: الثاني رمزٌ تعبيريّ يُرسَم بخطّ ملوّن (Segoe UI
                                         Emoji) فيتجاهل Foreground ويخرج أسودَ على خلفيّة داكنة.
                                         هذا محرفٌ نصّيّ عاديّ يتبع لون النصّ كبقيّة الرقاقة. -->
                                    <TextBlock Text="✦" FontSize="{DynamicResource Size.Small}"
                                               Margin="0,0,7,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextMuted}"/>
                                    <TextBlock x:Name="ComposerModelText" VerticalAlignment="Center" MaxWidth="180"
                                               FontFamily="Cascadia Mono, Consolas" FlowDirection="LeftToRight"
                                               FontSize="{DynamicResource Size.Small}"
                                               Foreground="{DynamicResource Brush.TextMuted}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                               Margin="7,1,0,0" VerticalAlignment="Center" Opacity="0.7"
                                               Foreground="{DynamicResource Brush.TextMuted}"/>
                                </StackPanel>
                            </Button>
                            </StackPanel>

                            <!-- لوحة اختيار النموذج -->
                            <Popup x:Name="ModelPickerPopup" PlacementTarget="{Binding ElementName=ComposerModelChip}"
                                   Placement="Top" StaysOpen="False" AllowsTransparency="True"
                                   PopupAnimation="Fade" HorizontalOffset="0" VerticalOffset="-6">
                                <!-- الاتّجاه يُضبَط من الكود بلغة الواجهة لا بالوراثة: محتوى الـPopup
                                     يعيش في شجرة منفصلة، وربطُه باتّجاه هذا العنصر كان يلتقط
                                     RightToLeft المكتوب في XAML فتُقلَب لوحةٌ نصّها إنجليزيّ —
                                     ويُعاد ترتيب أرقام سطر العدّ فتقرأ «of 341 models 341». -->
                                <Border x:Name="ModelPickerRoot" Style="{StaticResource CardStrong}"
                                        Padding="12" Width="380">
                                    <StackPanel>
                                        <TextBlock x:Name="ModelPickerTitle" Style="{StaticResource Caption}"
                                                   Margin="2,0,2,8" HorizontalAlignment="Left"/>

                                        <!-- البحث ومرشّح المجّانيّة في سطر واحد: سطران لعنصرَي ترشيح
                                             يأكلان من ارتفاع القائمة بلا مقابل. -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox x:Name="ModelPickerSearch" Padding="8,5"
                                                     FlowDirection="LeftToRight"
                                                     FontFamily="Cascadia Mono, Consolas"
                                                     TextChanged="ModelPickerSearch_TextChanged"/>

                                            <CheckBox Grid.Column="1" x:Name="ModelPickerFreeOnly"
                                                      Style="{StaticResource AppCheckBox}"
                                                      Margin="10,0,2,0" VerticalAlignment="Center"
                                                      Checked="ModelPickerFilter_Changed" Unchecked="ModelPickerFilter_Changed"/>
                                        </Grid>

                                        <ListBox x:Name="ModelPickerList" Height="220" BorderThickness="0"
                                                 Background="Transparent" FlowDirection="LeftToRight"
                                                 HorizontalContentAlignment="Stretch"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 MouseDoubleClick="ModelPickerList_DoubleClick">
                                            <ListBox.Resources>
                                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThemedScrollBar}"/>
                                            </ListBox.Resources>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Id}" TextTrimming="CharacterEllipsis"
                                                                   FontFamily="Cascadia Mono, Consolas"
                                                                   FontSize="{DynamicResource Size.Small}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Badge}" Margin="8,0,0,0"
                                                                   FontSize="{DynamicResource Size.Tiny}"
                                                                   Foreground="{DynamicResource Brush.Accent}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <TextBlock x:Name="ModelPickerStatus" TextWrapping="Wrap" Margin="2,8,2,0"
                                                   FontSize="{DynamicResource Size.Small}"
                                                   Foreground="{DynamicResource Brush.TextMuted}"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button x:Name="ModelPickerApply" Style="{StaticResource AccentButton}"
                                                    Padding="16,6" Click="ModelPickerApply_Click"/>
                                            <Button x:Name="ModelPickerCancel" Margin="8,0,0,0" Padding="14,6"
                                                    Click="ModelPickerCancel_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <!-- مبدّل الوضع: أمر ⇄ ذكاء. نقطة الدخول الظاهرة للمساعد — بلا مبدّل
                                 بجانب الكتابة تبقى الميزة خلف قائمة لا يفتحها أحد. -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">

                                <!-- منتقي النموذج انتقل إلى رقاقة بجانب المسار: هناك مكانه الطبيعيّ
                                     («أين أنا» و«من سيجيبني»)، وهنا كان يزاحم مبدّل الوضع. -->

                                <Border x:Name="ComposerModeSwitch"
                                        VerticalAlignment="Center"
                                        CornerRadius="8" Padding="2"
                                        Background="{DynamicResource Brush.KeyCap}">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="ComposerModeCmdBtn" Style="{StaticResource ComposerSeg}"
                                                  Click="ComposerModeCmd_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="❯" FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="{DynamicResource Size.Ui}" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ComposerModeCmdText" Margin="6,0,0,0"
                                                       FontSize="{DynamicResource Size.Ui}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton x:Name="ComposerModeAiBtn" Style="{StaticResource ComposerSeg}"
                                                  Click="ComposerModeAi_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✨" FontSize="{DynamicResource Size.Ui}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ComposerModeAiText" Margin="6,0,0,0"
                                                       FontSize="{DynamicResource Size.Ui}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ToggleButton>
                                </StackPanel>
                                </Border>
                            </StackPanel>
                            </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- رمز الموجّه: ❯ في وضع الأمر، ✨ في وضع الذكاء — إشارة الوضع الأوضح
                                 لأنّها حيث تنظر عند الكتابة. -->
                            <TextBlock Grid.Column="0" x:Name="ComposerGlyph" Text="❯"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" FontFamily="Cascadia Mono, Consolas"
                                       FontSize="{DynamicResource Size.Heading}" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Accent}"/>
                            <!-- طبقة الشبح: ذيل الإكمال (لون أفتح مكتوم) + حبّة tab — تُوضَع أفقيّاً عند
                                 نهاية النصّ المكتوب عبر GetRectFromCharacterIndex فتتحاذى تماماً. -->
                            <Canvas Grid.Column="1" IsHitTestVisible="False" ClipToBounds="True">
                                <!-- مؤشّر مخصّص واضح (شريط باللكنة) — أوضح من مؤشّر النظام الرفيع.
                                     يُوضَع عند موضع الكتابة عبر GetRectFromCharacterIndex ويومض. -->
                                <Border x:Name="ComposerCaret" Width="2.5" Height="18" CornerRadius="1"
                                        Background="{DynamicResource Brush.Accent}" Visibility="Collapsed"/>
                                <StackPanel x:Name="ComposerGhostPanel" Orientation="Horizontal"
                                            Canvas.Top="0" Visibility="Collapsed">
                                    <TextBlock x:Name="ComposerGhost"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource Size.Ui}"
                                               Foreground="{DynamicResource Brush.TextMuted}" Opacity="0.5"/>
                                    <Border x:Name="ComposerTabChip" Margin="8,0,0,0" Padding="6,0"
                                            Height="17" VerticalAlignment="Center" CornerRadius="4"
                                            Background="{DynamicResource Brush.KeyCap}">
                                        <TextBlock Text="tab" FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="{DynamicResource Size.Small}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                                    </Border>
                                </StackPanel>
                            </Canvas>
                            <!-- نصّ إرشاديّ: يختفي فور الكتابة، ويتبدّل مع الوضع (أمر/ذكاء) -->
                            <TextBlock Grid.Column="1" x:Name="ComposerPlaceholder"
                                       IsHitTestVisible="False" VerticalAlignment="Center"
                                       FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource Size.Ui}"
                                       Opacity="0.42" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                            <TextBox Grid.Column="1" x:Name="ComposerInput"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     MinHeight="34"
                                     Foreground="{DynamicResource Brush.Text}"
                                     CaretBrush="Transparent"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource Size.Ui}"
                                     AcceptsReturn="True" AcceptsTab="False" MaxLength="0"
                                     TextWrapping="Wrap" MaxLines="10"
                                     VerticalScrollBarVisibility="Auto"
                                     TextChanged="Composer_TextChanged"
                                     SelectionChanged="Composer_SelectionChanged"
                                     LostKeyboardFocus="Composer_LostFocus"
                                     GotKeyboardFocus="Composer_GotFocus"
                                     PreviewKeyDown="Composer_PreviewKeyDown"/>
                            <!-- زرّ التنفيذ: كان TextBlock بحجم ضئيل وOpacity ‎0.4‎ — يبدو زرّاً ولا
                                 يستجيب للنقر. صار زرّاً حقيقيّاً بمساحة نقرٍ ‎28×28‎، يُعتِم حين
                                 يفرغ الصندوق ويتلوّن باللكنة حين يصير فيه ما يُنفَّذ. -->
                            <Button Grid.Column="2" x:Name="ComposerSendBtn"
                                    Width="28" Height="28" Margin="10,0,0,0" Padding="0"
                                    Cursor="Hand" Focusable="False" Click="ComposerSend_Click"
                                    ToolTip="{loc:T term.send}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" CornerRadius="7" Background="Transparent">
                                                        <TextBlock x:Name="Gl" Text="&#xE751;"
                                                                   FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{TemplateBinding Foreground}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background"
                                                                    Value="{DynamicResource Brush.KeyCap}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <!-- صندوق فارغ ⇒ الزرّ باهت ومحايد (Enter المجرّدة تمرّ
                                                 للصدفة كسطرٍ فارغ)؛ وفيه نصّ ⇒ حيّ بلون اللكنة. -->
                                            <DataTrigger Binding="{Binding Text, ElementName=ComposerInput}" Value="">
                                                <Setter Property="Opacity" Value="0.4"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- الفاصل القابل للسحب — ظاهر فقط حين يكون المحرّر مفتوحاً -->
            <GridSplitter x:Name="EditorSplitter" Grid.Column="1" Width="4"
                          Visibility="Collapsed"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{DynamicResource Brush.Border}"
                          FlowDirection="LeftToRight"/>

            <!-- لوحة تحرير الملفّ داخل التاب (T-7) — مطويّة حتى فتح ملفّ -->
            <ctrl:FileEditorPanel x:Name="EditorPanel" Grid.Column="2"
                                  Visibility="Collapsed"/>
        </Grid>

        <!-- لوحة مساعد الـAI: تمتدّ على الصفّين بجانب التيرمنال. مطويّة حتى يفتحها المستخدم،
             ومملوكة لهذا التبويب — تُغلَق ويُلغى بثّها عند إغلاقه. -->
        <ctrl:AiPanel x:Name="AiSidePanel" Grid.Column="1" Grid.RowSpan="2"
                      Width="360" Visibility="Collapsed"/>

        <!-- رقاقة «اشرح هذا الخطأ؟»: تعوم فوق التيرمنال بلا إزاحة تخطيط ولا سرقة تركيز. -->
        <ctrl:AiErrorChip x:Name="AiErrorChip" Grid.Row="1" Grid.Column="0" Panel.ZIndex="50"/>
    </Grid>
</UserControl>
