<UserControl x:Class="TerminalLauncher.Controls.AiPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:TerminalLauncher.Controls"
             Background="{DynamicResource Brush.Surface}"
             TextOptions.TextFormattingMode="Display">

    <!-- الأرقام لاتينيّة دائماً حتى في العربيّة؛ الاتّجاه يُضبط حيّاً من Loc.Flow في الكود. -->
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="NumberSubstitution.Substitution" Value="European"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- الترويسة: العنوان + وسم المزوّد/النموذج + أفعال المحادثة -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface2}"
                BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="0,0,0,1" Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="{DynamicResource Size.Small}" FontWeight="SemiBold"/>
                    <!-- المزوّد نصّاً، والنموذج منسدلة قابلة للكتابة: تبديل النموذج لتجربة واحدة
                         لا يستحقّ فتح الإعدادات وتغيير إعداد دائم. -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock x:Name="OriginText" FontSize="{DynamicResource Size.Tiny}" VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   TextTrimming="CharacterEllipsis"/>
                        <ComboBox x:Name="ModelCombo" IsEditable="True" IsTextSearchEnabled="False"
                                  StaysOpenOnEdit="True" MaxDropDownHeight="260"
                                  Height="24" FontSize="{DynamicResource Size.Tiny}" MinWidth="120" MaxWidth="210"
                                  FlowDirection="LeftToRight"
                                  DropDownOpened="ModelCombo_DropDownOpened"
                                  SelectionChanged="ModelCombo_SelectionChanged"
                                  LostFocus="ModelCombo_LostFocus"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <!-- عدّاد التوكنز: يظهر فقط حين يُبلغ المزوّد عن الاستهلاك (لا تفعل كلّ المنصّات). -->
                    <TextBlock x:Name="TokenText" FontSize="{DynamicResource Size.Tiny}" VerticalAlignment="Center"
                               Margin="0,0,8,0" Visibility="Collapsed" FlowDirection="LeftToRight"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                    <Button x:Name="HistoryBtn" Style="{StaticResource IconButton}"
                            Content="↻" Click="History_Click"/>
                    <Button x:Name="CopyAllBtn" Style="{StaticResource IconButton}"
                            Content="⧉" Click="CopyAll_Click"/>
                    <Button x:Name="ClearBtn" Style="{StaticResource IconButton}"
                            Content="✚" Click="Clear_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- المحادثة + لوحة المعاينة المضمّنة (تظهر قبل أيّ إرسال يحمل سياقاً) -->
        <ScrollViewer Grid.Row="1" x:Name="Scroller" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="10,8">
            <StackPanel>
                <StackPanel x:Name="MessageHost"/>
                <ctrl:AiContextPreview x:Name="ContextPreview" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <!-- طبقة الجلسات السابقة: تعلو المحادثة ولا تمسّها — قراءة محادثة قديمة لا يجوز أن تُضيع
             ما أنت فيه الآن. -->
        <Border Grid.Row="1" x:Name="HistoryOverlay" Visibility="Collapsed"
                Background="{DynamicResource Brush.Surface}">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,8">
                    <TextBlock x:Name="HistoryTitle" FontSize="{DynamicResource Size.Small}" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button x:Name="HistoryCloseBtn" HorizontalAlignment="Right"
                            Style="{StaticResource TextLinkButton}" Content="✕"
                            Click="HistoryClose_Click"/>
                </Grid>

                <ListBox Grid.Row="1" x:Name="HistoryList" MaxHeight="170" BorderThickness="0"
                         Background="Transparent" SelectionChanged="HistoryList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Size.Small}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding When}" FontSize="{DynamicResource Size.Tiny}" FlowDirection="LeftToRight"
                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="1" x:Name="HistoryEmpty" Visibility="Collapsed"
                           TextWrapping="Wrap" FontSize="{DynamicResource Size.Small}" Margin="6,10"
                           Foreground="{DynamicResource Brush.TextMuted}"/>

                <TextBox Grid.Row="2" x:Name="HistoryTranscript" IsReadOnly="True" Margin="0,8,0,0"
                         Style="{StaticResource MultilineTextBox}"
                         Padding="8,6" FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource Size.Small}"
                         FlowDirection="LeftToRight"/>
            </Grid>
        </Border>

        <!-- شريط الخطأ: رسالة بشريّة + زرّ إجراء واحد -->
        <Border Grid.Row="2" x:Name="ErrorBar" Visibility="Collapsed" Margin="8,0,8,8"
                Background="{DynamicResource Brush.Surface2}"
                BorderBrush="{DynamicResource Brush.Danger}" BorderThickness="1"
                CornerRadius="6" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="{DynamicResource Size.Small}"/>
                    <TextBlock x:Name="ErrorOrigin" FontSize="{DynamicResource Size.Tiny}" Margin="0,3,0,0"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="ErrorActionBtn" Style="{StaticResource AccentButton}"
                        VerticalAlignment="Center" Margin="8,0,0,0" Click="ErrorAction_Click"/>
            </Grid>
        </Border>

        <!-- الإدخال -->
        <Border Grid.Row="3" Background="{DynamicResource Brush.Surface2}"
                BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="0,1,0,0" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" x:Name="InputBox" Style="{StaticResource SearchPill}"
                         AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120"
                         VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="Input_PreviewKeyDown"/>

                <Button Grid.Column="1" x:Name="SendBtn" Style="{StaticResource AccentButton}"
                        Margin="6,0,0,0" MinWidth="64" Click="Send_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
