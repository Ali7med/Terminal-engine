<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:TerminalLauncher.Theme"
                    xmlns:ctrl="clr-namespace:TerminalLauncher.Controls">

    <!-- ========== خطّ ولون افتراضيان ========== -->
    <Style TargetType="{x:Type FrameworkElement}" x:Key="BaseText"/>

    <!-- ========== زر أيقونة مدمج (شريط التيرمنال) ========== -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="FontSize" Value="{DynamicResource Size.Ui}"/>
        <Setter Property="Margin" Value="2,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="{DynamicResource Radius.Control}" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="FontSize" Value="{DynamicResource Size.Ui}"/>
        <Setter Property="Margin" Value="2,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" CornerRadius="{DynamicResource Radius.Control}" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== ComboBox مدمج ========== -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- زرّ سهم المنسدلة: يُستعمَل في الوضع القابل للتحرير حيث لا يغطّي سطحُ النقر الصندوقَ كلّه
         (وإلّا ابتلع النقرَ قبل أن يصل حقلَ الكتابة). له ContentPresenter بعكس ComboToggle. -->
    <Style x:Key="ComboArrowToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Padding="8,0,2,0">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- حقل الكتابة داخل ComboBox قابل للتحرير: بلا كروم — الصندوق الخارجيّ يرسم الحدّ والخلفيّة.
         بلا هذا النمط يرث الحقلُ نمطَ TextBox الضمنيّ فيظهر صندوق داخل صندوق. -->
    <Style x:Key="ComboEditableText" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="IBeam"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- شريط تمرير نحيل لمنسدلة الـComboBox. محلّيّ لأنّ ThemedScrollBar معرَّف في App.xaml
         *بعد* دمج هذا الملفّ، فلا يراه StaticResource من هنا. -->
    <Style x:Key="ComboScroll" TargetType="ScrollBar">
        <Setter Property="Width" Value="9"/>
        <Setter Property="MinWidth" Value="9"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Th" CornerRadius="4" Margin="2,0"
                                                    Background="{DynamicResource Brush.Border}"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Th" Property="Background"
                                                            Value="{DynamicResource Brush.Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox: يدعم الوضعين — العرض فقط، والقابل للتحرير (IsEditable) الذي يحتاج
         PART_EditableTextBox بهذا الاسم حرفيّاً كي يربطه WPF بالنصّ. بدونه لا يُكتب في الصندوق
         ولا يظهر المختار أصلاً — وهو سبب «قائمة النماذج لا تختار». -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Surface2}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontSize" Value="{DynamicResource Size.Small}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- سطح نقر يغطّي الصندوق كلّه — للوضع غير القابل للتحرير فقط؛ في الوضع
                             القابل للتحرير يعلوه الحدُّ الملتقِط للنقر فلا يصله شيء. -->
                        <ToggleButton Style="{StaticResource ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Border x:Name="bd" CornerRadius="{DynamicResource Radius.Control}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="10,0,8,0" IsHitTestVisible="False">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="SelectionBox"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  VerticalAlignment="Center"/>
                                <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed"
                                         Style="{StaticResource ComboEditableText}"
                                         IsReadOnly="{TemplateBinding IsReadOnly}"/>
                                <ToggleButton x:Name="Arrow" Grid.Column="1"
                                              Style="{StaticResource ComboArrowToggle}"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                               Foreground="{DynamicResource Brush.TextMuted}"/>
                                </ToggleButton>
                            </Grid>
                        </Border>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border CornerRadius="{DynamicResource Radius.Control}" Margin="0,4,0,0" Padding="4"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <!-- ارتفاع محدود: قائمة نماذج المزوّد قد تبلغ مئات العناصر، وبلا
                                     ScrollViewer تمتدّ المنسدلة خارج الشاشة (MaxDropDownHeight يُهمَل). -->
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ComboScroll}"/>
                                    </ScrollViewer.Resources>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- الوضع القابل للتحرير: حقل الكتابة بدل صندوق العرض، والحدّ يلتقط النقر
                             كي يصل إلى الحقل والسهم. -->
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="SelectionBox" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="bd" Property="IsHitTestVisible" Value="True"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" CornerRadius="{DynamicResource Radius.Control}" Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== عنوان قسم ========== -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        <Setter Property="FontSize" Value="{DynamicResource Size.Small}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="2,0,2,6"/>
    </Style>

    <!-- ========== بطاقة ==========
         الواجهة المريحة: السطح زجاجيّ (تُرى الخلفيّة خلفه) والحدّ خطّ شعرة لا خطّ صريح — الفصل
         يقع بالمسافة والعتامة، لا بالخطوط. للأسطح التي يجب أن تُقرأ تماماً استعمل CardStrong. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Glass}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}"/>
    </Style>

    <!-- بطاقة كثيفة: للوحات المنبثقة/الحواريّة التي تعلو المحتوى ويجب أن يبقى نصّها مقروءاً. -->
    <Style x:Key="CardStrong" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{DynamicResource Brush.GlassStrong}"/>
    </Style>

    <!-- ========== عنوان مجموعة (Caption) ==========
         السطر فوق مجموعة عناصر («الاتّصال»، «الإعدادات»). هو <b>أعلى</b> من SectionLabel في
         التسلسل لا أدنى منه: كان يقرأ حجم «النصّ الدقيق» فيخرج أصغر من عناوين الحقول تحته —
         ترتيبٌ مقلوب يجعل عنوان المجموعة أخفت ما في الشاشة. -->
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        <Setter Property="FontSize" Value="{DynamicResource Size.Heading}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Opacity" Value="0.9"/>
        <Setter Property="Margin" Value="10,10,10,4"/>
    </Style>

    <!-- ========== زرّ كيبورد (KeyCap) ==========
         رقاقة اختصار صغيرة تُستعمل في لوحات التلميح: ctrl · shift · ↵ -->
    <Style x:Key="KeyCap" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.KeyCap}"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="6,1"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="KeyCapText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}"/>
        <Setter Property="FontSize" Value="{DynamicResource Size.Tiny}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        <Setter Property="FlowDirection" Value="LeftToRight"/>
    </Style>

    <!-- ========== حقل بحث حبّة (Pill) ==========
         حقل البحث المركزيّ في شريط العنوان: بلا حدّ ظاهر، خلفيّة زجاجيّة، استدارة كاملة. -->
    <Style x:Key="SearchPill" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.KeyCap}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="{DynamicResource Size.Small}"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="30,0,12,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" CornerRadius="{DynamicResource Radius.Pill}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <!-- أيقونة العدسة تلزم حافّة البداية مهما كان اتّجاه الواجهة -->
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource Brush.TextMuted}" Opacity="0.8"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0"/>
                            <!-- النصّ البديل: يظهر ما دام الحقل فارغاً -->
                            <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" FontSize="{DynamicResource Size.Small}"
                                       Visibility="Collapsed"
                                       Foreground="{DynamicResource Brush.TextMuted}" Opacity="0.7"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Margin="{TemplateBinding Padding}" IsHitTestVisible="False"/>
                            <!-- بلا Margin: ‏WPF يطبّق Padding الحقل على مضيف المحتوى بنفسه، فإضافته
                                 هنا هامشاً تُزيح النصّ ضِعف الحشو — ويبقى النصّ البديل عند الحشو
                                 الصحيح فيقفز النصّ عنه أوّل ما تكتب. -->
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Hairline}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== زر افتراضي (Ghost) ========== -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Surface2}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="FontSize" Value="{DynamicResource Size.Small}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="{DynamicResource Radius.Control}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== زر أساسي (Accent) ========== -->
    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{DynamicResource Size.Small}"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="{DynamicResource Radius.Control}"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- زرّ خطر (حذف/إجراء لا رجعة فيه): أحمر واضح مميّز عن اللكنة البرتقاليّة -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#E5484D"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="{DynamicResource Radius.Control}"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#D13B40"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== أزرار إطار النافذة ========== -->
    <Style x:Key="ChromeButton" TargetType="Button">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="{DynamicResource Size.Tiny}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="{DynamicResource Radius.Control}" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== زرّ الإجراء البارز في شريط العنوان ==========
         «تيرمنال جديد» هو الفعل الأوّل في التطبيق، وبأيقونة مكتومة بين أيقونات مكتومة لا يُرى.
         حبّة ممتلئة بلون اللكنة تجعله أوضح عنصر في الشريط بلا أن يزيد حجمه. -->
    <Style x:Key="ChromeAccentButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="{DynamicResource Radius.Control}"
                            Background="{DynamicResource Brush.Accent}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.86"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- زرّ نصّيّ بلا كروم: للروابط داخل الأشرطة («افتح المحادثة»، «لا تُظهر ثانيةً»).
         <b>لا يُبنى على ChromeButton</b> — ذاك يفرض خطّ Segoe MDL2 Assets (خطّ أيقونات لا حروف
         فيه)، فأيّ نصّ عربيّ أو لاتينيّ عليه يظهر مربّعات فارغة. -->
    <Style x:Key="TextLinkButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource Size.Small}"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="6" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.RowHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== زرّ «الدليل» ==========
         أيقونة استفهام تنبض نبضاً بطيئاً + نصّ بخطّ الواجهة.

         <b>لماذا النبض:</b> زرّ ساكن بلون خافت في رأس قسم لا يراه أحد. النبض حركةٌ صغيرة
         محيطيّة تكفي لتقول «هنا شرح» بلا أن تسرق الانتباه من العمل — ويهدأ فور المرور بالفأرة
         فلا يبقى يتحرّك تحت المؤشّر.

         <b>الأيقونة في TextBlock مستقلّ</b> لا على الزرّ: خطّ Segoe MDL2 Assets خطّ أيقونات بلا
         حروف، ففرضُه على الزرّ كلّه يحوّل نصّه إلى مربّعات. -->
    <Style x:Key="GuideButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource Size.Small}"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="{DynamicResource Radius.Control}"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderThickness="1" BorderBrush="{DynamicResource Brush.Hairline}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="glyph" Text="&#xE897;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </TextBlock.RenderTransform>
                                <!-- المشغّل على العنصر نفسه لا في ControlTemplate.Triggers: حدث Loaded
                                     يُبَثّ إلى الزرّ (الحاوية) لا إلى داخل القالب، فيُنفَّذ المشغّل في نطاق
                                     أسماء النمط حيث لا وجود لـ«glyph» — ويُرمى InvalidOperationException
                                     عند كلّ ظهور للزرّ. هنا لا حاجة إلى TargetName أصلاً: الهدف هو
                                     العنصر المالك للمشغّل. -->
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.42" Duration="0:0:1.3"
                                                                 AutoReverse="True" RepeatBehavior="Forever"/>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                                 From="1" To="1.22" Duration="0:0:1.3"
                                                                 AutoReverse="True" RepeatBehavior="Forever"/>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                                 From="1" To="1.22" Duration="0:0:1.3"
                                                                 AutoReverse="True" RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </TextBlock.Triggers>
                            </TextBlock>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- نسخة شريط العنوان: أيقونة وحدها بمقاس أزرار الشريط، بنبض الشفافيّة وحده.
         بلا تحجيم: قيمة Freezable في Setter نمطٍ تُجمَّد وتُشارَك بين كلّ نسخ الزرّ، فلا يمكن
         تحريكها — والشفافيّة تكفي لتقول «انظر هنا» في شريط أزراره صغيرة متجاورة. -->
    <Style x:Key="ChromeGuideButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="1" To="0.45" Duration="0:0:1.3"
                                         AutoReverse="True" RepeatBehavior="Forever"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ChromeCloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="{DynamicResource Radius.Control}" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Danger}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== زر إغلاق التاب ========== -->
    <Style x:Key="TabCloseButton" TargetType="Button">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="{DynamicResource Size.Small}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="{DynamicResource Radius.Control}" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Danger}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== حقل نص ========== -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Surface2}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="{DynamicResource Size.Small}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" CornerRadius="{DynamicResource Radius.Control}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <!-- النصّ الإرشاديّ خلف مضيف المحتوى وغير قابل للنقر: النقر يصل إلى
                                 الحقل نفسه فيضع المؤشّر، لا إلى نصّ يبتلع النقرة. -->
                            <TextBlock x:Name="ph" IsHitTestVisible="False" Visibility="Collapsed"
                                       Text="{Binding (theme:Placeholder.Text), RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{DynamicResource Brush.TextMuted}" Opacity="0.65"
                                       FontSize="{TemplateBinding FontSize}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- حقل نصّ متعدّد الأسطر: كالضمنيّ لكنّ مضيف المحتوى ممتدّ لا موسَّط عموديّاً — التوسيط يجعل
         النصّ الطويل يفيض خارج الحدّ بدل أن يمرّر داخله. -->
    <Style x:Key="MultilineTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <!-- الأفقيّ معطَّل صراحةً: النصّ ملتفّ فلا حاجة إليه، وComboScroll المستعار أدناه نمطُ
             شريطٍ رأسيّ (عرض ثابت 9 ومسار معكوس) فيظهر أفقيّاً شريحةً مقلوبة الاتّجاه. -->
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" CornerRadius="{DynamicResource Radius.Control}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <!-- محاذاة علويّة لا موسّطة: الحقل المتعدّد يبدأ الكتابة من أعلاه،
                                 فنصٌّ إرشاديّ موسَّط عموديّاً يقفز حين تُكتب أوّل كلمة. -->
                            <TextBlock x:Name="ph" IsHitTestVisible="False" Visibility="Collapsed"
                                       Text="{Binding (theme:Placeholder.Text), RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{DynamicResource Brush.TextMuted}" Opacity="0.65"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Top" TextWrapping="Wrap"/>
                            <ScrollViewer x:Name="PART_ContentHost">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ComboScroll}"/>
                                </ScrollViewer.Resources>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== قائمة ========== -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <!-- صفّ القائمة: بلا حدّ ولا شريط جانبيّ — التمرير ظلّ خافت، والنشِط تعبئة طينيّة
                     مخفّفة. حشوة سخيّة (12,10) كي يتنفّس السطران (اسم + مسار). -->
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,1"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="bd" CornerRadius="{DynamicResource Radius.Control}" Padding="12,10"
                                        Background="Transparent" BorderThickness="0">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.RowHover}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.RowActive}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- شريط تمرير أفقيّ نحيل لرأس التبويبات. محلّيّ لا BasedOn=ThemedScrollBar للسبب نفسه
         أعلاه (App.xaml يُدمَج بعد هذا الملفّ فلا يراه StaticResource من هنا). -->
    <Style x:Key="TabStripScrollBar" TargetType="ScrollBar">
        <Setter Property="Height" Value="7"/>
        <Setter Property="MinHeight" Value="7"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" Orientation="Horizontal">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageLeftCommand" Focusable="False" Background="Transparent" BorderThickness="0">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageRightCommand" Focusable="False" Background="Transparent" BorderThickness="0">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb MinWidth="24">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Th" CornerRadius="3" Margin="0,1" Background="{DynamicResource Brush.Border}"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Th" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== تبويبات ========== -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- لوحة مخصّصة لا TabPanel: هي التي ترسم إطار كلّ مجموعة واسمها خلف
                             أعضائها — رؤوس التبويبات إخوةٌ في لوحة واحدة فلا سبيل لِلَفّ بعضها.
                             ScrollViewer حول اللوحة: كثرة التابات تفيض عن عرض الهدر بلا هذا، ولا سبيل
                             للوصول إليها. -->
                        <!-- خلفيّة زجاجيّة كثيفة: عند خلفيّة صورة/تدرّج خلف النافذة يبقى الهدر شفّافاً بلا هذا
                             فتضيع رؤوس التبويبات فيه — GlassStrong تجعله يبرز بغضّ النظر عن نوع الخلفيّة. -->
                        <Border Grid.Row="0" Padding="4,4,4,8" Background="{DynamicResource Brush.GlassStrong}">
                            <ScrollViewer x:Name="TabStripScroll" Focusable="False"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          PanningMode="HorizontalOnly">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource TabStripScrollBar}"/>
                                </ScrollViewer.Resources>
                                <ctrl:TabStripPanel x:Name="TabStrip" IsItemsHost="True" Panel.ZIndex="1"/>
                            </ScrollViewer>
                        </Border>
                        <!-- إطار محتوى التيرمنال: بلا استدارة ولا حدّ ولا خلفيّة — الخلفيّة يرسمها العارض
                             والإنبت بنفس التعتيم، فيصيران قطعةً واحدة متّصلة بلا بنل مؤطِّر. -->
                        <Border x:Name="TerminalContentBorder" Grid.Row="1"
                                CornerRadius="0" ClipToBounds="True"
                                Background="Transparent" BorderThickness="0">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- شفّاف صراحةً: خلفيّة القالب صارت مربوطة بـTemplateBinding لتحمل لون المجموعة، وبلا هذا
             السطر ترث TabItem خلفيّتها الافتراضيّة من ثيم النظام (تدرّج فاتح) فتخرج التبويبات عن
             ثيم التطبيق كلّه. اللون يعود من الكود فقط حين يختار المستخدم لوناً للمجموعة. -->
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <!-- تبويب شبح: شفّاف افتراضاً، والمحدَّد تعبئة طينيّة مخفّفة بنصّ عاديّ اللون —
                         بدل المستطيل الممتلئ باللكنة الذي كان يسحب العين بعيداً عن التيرمنال.

                         طبقتان: «tint» تحمل لون مجموعة التبويب (يُضبَط من الكود على
                         TabItem.Background)، و«bd» فوقها تحمل حالة التمرير/التحديد. الفصل ضروريّ:
                         لو تشاركتا خاصّيةً واحدة لمحا مشغّلا الحالة لونَ المجموعة عند أوّل مرور فأرة. -->
                    <Border x:Name="tint" CornerRadius="{DynamicResource Radius.Control}"
                            Background="{TemplateBinding Background}">
                        <Border x:Name="bd" CornerRadius="{DynamicResource Radius.Control}" Padding="12,7"
                                Background="Transparent" BorderThickness="0">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.RowHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.RowActive}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                            <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== مبدّل مقطعي (Dark/Light) ========== -->
    <Style x:Key="SegToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="FontSize" Value="{DynamicResource Size.Small}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" CornerRadius="{DynamicResource Radius.Control}" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== مبدّل تشغيل/إيقاف (Acrylic) ========== -->
    <Style x:Key="SwitchToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="track" Width="44" Height="24" CornerRadius="12"
                            Background="{DynamicResource Brush.Surface2}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <Ellipse x:Name="knob" Width="16" Height="16" HorizontalAlignment="Left"
                                 Margin="4,0,0,0" Fill="{DynamicResource Brush.TextMuted}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="knob" Property="Margin" Value="0,0,4,0"/>
                            <Setter TargetName="knob" Property="Fill" Value="{DynamicResource Brush.OnAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== منزلق الشفافية ========== -->
    <Style x:Key="AccentSlider" TargetType="Slider">
        <Setter Property="Height" Value="24"/>
        <!-- نقرة واحدة على المسار تنقل المقبض إلى موضعها (بدل قفزة LargeChange) — يسهّل اختيار قيمة دقيقة -->
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="6" CornerRadius="3" Background="{DynamicResource Brush.Surface2}"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="6" CornerRadius="3" Background="{DynamicResource Brush.Accent}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="18" Height="18" Fill="White"
                                                     Stroke="{DynamicResource Brush.Accent}" StrokeThickness="4"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== خانة اختيار ========== -->
    <Style x:Key="AppCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="FontSize" Value="{DynamicResource Size.Small}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="18" Height="18" CornerRadius="5"
                                Background="{DynamicResource Brush.Surface2}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="check" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.OnAccent}" Opacity="0"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            <Setter TargetName="check" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== القائمة السياقية (كلك أيمن / منيو الثلاث نقاط) ========== -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="FontSize" Value="{DynamicResource Size.Menu}"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <!-- هامش يفسح مكاناً للظلّ حول اللوحة -->
                    <Border CornerRadius="{DynamicResource Radius.Card}" Padding="5" MinWidth="168" Margin="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="3" Opacity="0.5"/>
                        </Border.Effect>
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Padding" Value="11,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="bd" CornerRadius="{DynamicResource Radius.Control}" Padding="{TemplateBinding Padding}" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- خانة الأيقونة (تنطوي إن لم تُحدَّد أيقونة) — تتبع اتّجاه القائمة تلقائيّاً -->
                            <ContentPresenter x:Name="icon" Grid.Column="0" ContentSource="Icon"
                                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ContentPresenter x:Name="hdr" Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                            <!-- تلميح اختصار لوحة المفاتيح (P/R/D…) للعناصر الطرفيّة -->
                            <TextBlock x:Name="gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                       Margin="30,0,2,0" VerticalAlignment="Center" FontSize="{DynamicResource Size.MenuGesture}"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                            <!-- سهم القائمة الفرعيّة (ينعكس تلقائيّاً مع RTL) -->
                            <Path x:Name="arrow" Grid.Column="2" Visibility="Collapsed" VerticalAlignment="Center"
                                  Margin="26,0,0,0" Data="M0,0 L4,4 L0,8 Z" Fill="{DynamicResource Brush.TextMuted}"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Right" HorizontalOffset="-6"
                                   Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1" CornerRadius="{DynamicResource Radius.Card}" Padding="5" MinWidth="168" Margin="8">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="3" Opacity="0.5"/>
                                    </Border.Effect>
                                    <ItemsPresenter/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="icon" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <!-- عنصر ذو قائمة فرعيّة: أظهِر السهم وأخفِ تلميح الاختصار -->
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="arrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="gesture" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="arrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="gesture" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                        </Trigger>
                        <!-- عنصر مُدمِّر (حذف): نصّ أحمر، وعند المرور خلفيّة حمراء ونصّ أبيض -->
                        <Trigger Property="Tag" Value="danger">
                            <Setter TargetName="hdr" Property="TextElement.Foreground" Value="{DynamicResource Brush.Danger}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="danger"/>
                                <Condition Property="IsHighlighted" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Danger}"/>
                            <Setter TargetName="hdr" Property="TextElement.Foreground" Value="White"/>
                            <Setter TargetName="gesture" Property="Foreground" Value="White"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- عنصر قائمة مُدمِّر (حذف) — أحمر. الاستعمال: Style="{StaticResource MenuItem.Danger}" -->
    <Style x:Key="MenuItem.Danger" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Tag" Value="danger"/>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Margin" Value="8,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource Brush.Border}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== زرّ الثلاث نقاط (⋮) — يفتح القائمة السياقيّة المرتبطة به ========== -->
    <Style x:Key="KebabButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="{DynamicResource Size.Title}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        <Setter Property="Content" Value="&#x22EE;"/>
        <!-- التلميح يضبطه ctrl:MenuButton.IsMenuTrigger مُعرَّباً (Setter.Value لا يقبل ربطاً) -->
        <Setter Property="ToolTip" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="{DynamicResource Radius.Control}" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== زرّ فئة الإعدادات (قائمة التنقّل الجانبيّة) ========== -->
    <Style x:Key="SettingsNavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="{DynamicResource Size.Ui}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" CornerRadius="{DynamicResource Radius.Control}" Padding="14,11"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
