<Window x:Class="TerminalLauncher.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="452" Height="292"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        NumberSubstitution.Substitution="European"
        Opacity="0"
        FontFamily="pack://application:,,,/Assets/Fonts/#Anthropic Sans, pack://application:,,,/Assets/Fonts/#Tajawal, Segoe UI, Tahoma">

    <!-- ملاحظة معماريّة: هذه النافذة تعمل على خيط مستقلّ (راجع SplashScreenHost)، لذا لا تستعمل
         أيّ StaticResource/DynamicResource من موارد التطبيق ولا أيّ كائن يملكه الخيط الرئيس —
         كلّ ألوانها تُضبَط في الباني من ثيم المستخدم (BootProfile + ThemeManager.Resolve). -->

    <Border x:Name="Root" Margin="20" CornerRadius="18" BorderThickness="1" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect x:Name="RootShadow" BlurRadius="40" ShadowDepth="6"
                              Direction="270" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <!-- هالة اللكنة خلف العلامة: تعطي عمقاً بلا صورة (تتبع لون الثيم) -->
            <Ellipse x:Name="Glow" Width="330" Height="330" Margin="0,-150,0,0"
                     HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False"/>

            <!-- العلامة داخل حلقة التحميل -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,26">
                <Grid Width="96" Height="96" HorizontalAlignment="Center">
                    <!-- مسار الحلقة (ثابت) ثمّ قوس اللكنة الدوّار: الدوران حول مركز دائرة كاملة
                         (قوس مرسوم بـ StrokeDashArray) فلا يهتزّ كما يحدث مع Path منفصل. -->
                    <Ellipse x:Name="RingTrack" Width="92" Height="92" StrokeThickness="3"/>
                    <Ellipse x:Name="RingArc" Width="92" Height="92" StrokeThickness="3"
                             StrokeDashArray="24 72" StrokeDashCap="Round"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="ArcSpin"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <Image x:Name="Mark" Width="50" Height="50"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="pack://application:,,,/Assets/AppIcon/icon-256.png"/>
                </Grid>

                <TextBlock x:Name="TitleText" Margin="0,20,0,0" FontSize="19" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextOptions.TextFormattingMode="Ideal"/>
                <TextBlock x:Name="VersionText" Margin="0,4,0,0" FontSize="11.5"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- شريط تقدّم غير محدّد + نصّ المرحلة الجارية -->
            <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,24" HorizontalAlignment="Center">
                <Border x:Name="BarTrack" Width="248" Height="3" CornerRadius="2" ClipToBounds="True">
                    <Border x:Name="BarFill" Width="86" Height="3" CornerRadius="2"
                            HorizontalAlignment="Left">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="BarSlide" X="-86"/>
                        </Border.RenderTransform>
                    </Border>
                </Border>
                <TextBlock x:Name="StatusText" Margin="0,12,0,0" FontSize="12"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- ظهور ناعم -->
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.18"/>
                    <!-- دوران القوس: هذا هو «مؤشّر التحميل» -->
                    <DoubleAnimation Storyboard.TargetName="ArcSpin"
                                     Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:1.1"
                                     RepeatBehavior="Forever"/>
                    <!-- كتلة الشريط تعبر من الطرف إلى الطرف بتسارع لطيف -->
                    <DoubleAnimation Storyboard.TargetName="BarSlide"
                                     Storyboard.TargetProperty="X"
                                     From="-86" To="248" Duration="0:0:1.35"
                                     RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
