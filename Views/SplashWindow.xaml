<Window x:Class="TerminalLauncher.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" Height="296"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        NumberSubstitution.Substitution="European"
        FlowDirection="LeftToRight"
        Opacity="0">

    <!-- ملاحظة معماريّة: هذه النافذة تعمل على خيط مستقلّ (راجع SplashScreenHost)، لذا لا تستعمل
         أيّ StaticResource/DynamicResource من موارد التطبيق ولا أيّ كائن يملكه الخيط الرئيس —
         كلّ ألوانها تُضبَط في الباني من ثيم المستخدم (BootProfile + ThemeManager.Resolve).
         الاتّجاه LTR دائماً: المحتوى محاكاة لجلسة تيرمنال، والتيرمنال يسار→يمين مهما كانت اللغة. -->

    <Border x:Name="Root" Margin="20" CornerRadius="12" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect x:Name="RootShadow" BlurRadius="40" ShadowDepth="6"
                              Direction="270" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== شريط عنوان نافذة التيرمنال: ثلاث نقاط + العلامة والاسم ===== -->
            <Border x:Name="TitleBar" Grid.Row="0" CornerRadius="11,11,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                VerticalAlignment="Center" Margin="14,0,0,0">
                        <Ellipse x:Name="Dot1" Width="11" Height="11" Margin="0,0,8,0"/>
                        <Ellipse x:Name="Dot2" Width="11" Height="11" Margin="0,0,8,0"/>
                        <Ellipse x:Name="Dot3" Width="11" Height="11"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Image x:Name="Mark" Width="16" Height="16" Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="pack://application:,,,/Assets/AppIcon/icon-256.png"/>
                        <TextBlock x:Name="TitleText" FontSize="12.5" VerticalAlignment="Center"
                                   FontFamily="pack://application:,,,/Assets/Fonts/#Anthropic Sans, pack://application:,,,/Assets/Fonts/#Tajawal, Segoe UI"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="TitleRule" Grid.Row="0" Height="1" VerticalAlignment="Bottom"/>

            <!-- ===== جسم الجلسة: أسطر تُطبَع تباعاً بخطّ أحاديّ المسافة ===== -->
            <Grid Grid.Row="1" Margin="20,16,20,12">
                <StackPanel x:Name="Lines" VerticalAlignment="Top"
                            TextOptions.TextFormattingMode="Display"
                            TextElement.FontFamily="Cascadia Mono, Consolas, Courier New"
                            TextElement.FontSize="13"/>

                <TextBlock x:Name="VersionText" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           FontSize="11.5" FontFamily="Cascadia Mono, Consolas, Courier New"/>
            </Grid>
        </Grid>
    </Border>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
