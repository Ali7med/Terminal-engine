<Window x:Class="TerminalLauncher.Views.CommandDictionaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="900" Height="620" MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Bg}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="NumberSubstitution.Substitution" Value="European"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- الترويسة -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" FontSize="{DynamicResource Size.Title}" FontWeight="SemiBold"/>
            <TextBlock x:Name="SubtitleText" FontSize="{DynamicResource Size.Small}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
        </StackPanel>

        <!-- البحث: يأخذ التركيز عند الفتح، والأسهم تتنقّل النتائج منه بلا مغادرته -->
        <Border Grid.Row="1" Margin="0,0,0,10" CornerRadius="{DynamicResource Radius.Control}"
                Background="{DynamicResource Brush.Surface2}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           VerticalAlignment="Center" Margin="12,0,8,0" Opacity="0.6"
                           Foreground="{DynamicResource Brush.TextMuted}"/>
                <TextBox Grid.Column="1" x:Name="SearchInput" BorderThickness="0" Background="Transparent"
                         Padding="0,9,12,9" FontSize="{DynamicResource Size.Ui}"
                         VerticalContentAlignment="Center"
                         TextChanged="Search_TextChanged" PreviewKeyDown="Search_PreviewKeyDown"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- النتائج -->
            <Border Grid.Column="0" CornerRadius="{DynamicResource Radius.Control}"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="1">
                <Grid>
                    <ListBox x:Name="ResultList" BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="ResultList_SelectionChanged"
                             MouseDoubleClick="ResultList_DoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,6">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                               FontSize="{DynamicResource Size.Ui}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Command}" Margin="0,3,0,0"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource Size.Small}"
                                               FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis"
                                               Opacity="0.75" Foreground="{DynamicResource Brush.TextMuted}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- حالة الفراغ: تشرح ما الذي يملأ القائمة بدل أن تترك بياضاً -->
                    <TextBlock x:Name="EmptyText" Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320" Opacity="0.7"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- المحرّر -->
            <Border Grid.Column="2" CornerRadius="{DynamicResource Radius.Control}" Padding="12"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="EditorPanel">
                        <TextBlock x:Name="LblTitle" FontSize="{DynamicResource Size.Small}" Margin="0,0,0,4"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <TextBox x:Name="FieldTitle" TextChanged="Field_Changed"/>

                        <TextBlock x:Name="LblCommand" FontSize="{DynamicResource Size.Small}" Margin="0,12,0,4"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <TextBox x:Name="FieldCommand" Style="{StaticResource MultilineTextBox}"
                                 MinHeight="90" MaxHeight="200" FlowDirection="LeftToRight"
                                 FontFamily="Cascadia Mono, Consolas" TextChanged="Field_Changed"/>

                        <TextBlock x:Name="LblDescription" FontSize="{DynamicResource Size.Small}" Margin="0,12,0,4"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <TextBox x:Name="FieldDescription" Style="{StaticResource MultilineTextBox}"
                                 MinHeight="54" MaxHeight="120" TextChanged="Field_Changed"/>

                        <TextBlock x:Name="LblTags" FontSize="{DynamicResource Size.Small}" Margin="0,12,0,4"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <TextBox x:Name="FieldTags" TextChanged="Field_Changed"/>

                        <TextBlock x:Name="UsageText" Margin="0,12,0,0" FontSize="{DynamicResource Size.Small}"
                                   Opacity="0.7" Foreground="{DynamicResource Brush.TextMuted}"/>

                        <Button x:Name="DeleteButton" Margin="0,14,0,0" HorizontalAlignment="Left"
                                Click="Delete_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- شريط الأفعال -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="NewButton" Click="New_Click" Padding="14,6"/>
                <Button x:Name="ImportButton" Click="Import_Click" Margin="8,0,0,0" Padding="14,6"/>
                <Button x:Name="ExportButton" Click="Export_Click" Margin="8,0,0,0" Padding="14,6"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CloseButton" Click="Close_Click" Padding="14,6"/>
                <Button x:Name="InsertButton" Click="Insert_Click" Margin="8,0,0,0" Padding="18,6"
                        Style="{StaticResource AccentButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
