<Window x:Class="TerminalLauncher.Views.ShellIntegrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" Height="560" MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Bg}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="NumberSubstitution.Substitution" Value="European"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" x:Name="ExplainText" FontSize="11.5" TextWrapping="Wrap"
                   Margin="0,6,0,10" Foreground="{DynamicResource Brush.TextMuted}"/>

        <!-- الـdiff الحرفيّ: ما سيُضاف إلى ملفّ البروفايل -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="PathText" FontSize="10.5" Margin="10,8,10,4"
                           FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Brush.TextMuted}"/>
                <TextBox Grid.Row="1" x:Name="DiffBox" IsReadOnly="True" BorderThickness="0"
                         Background="Transparent" Padding="10,0,10,8"
                         TextWrapping="NoWrap" AcceptsReturn="True" FlowDirection="LeftToRight"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono, Consolas" FontSize="11"
                         Foreground="{DynamicResource Brush.Success}"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" x:Name="StatusText" FontSize="11" TextWrapping="Wrap"
                   Margin="0,10,0,0"/>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="CopyBtn" Padding="14,7" Click="Copy_Click"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="InstallBtn" Style="{StaticResource AccentButton}"
                        Padding="16,7" Click="Install_Click"/>
                <Button x:Name="CloseBtn" Margin="8,0,0,0" Padding="14,7"
                        Click="Close_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
